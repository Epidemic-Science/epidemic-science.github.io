# ==============================================================================
# EPIDEMIC SCIENCE HUB WEBSITE — .gitignore
# Jekyll site deployed with GitHub Pages
# ==============================================================================

# ------------------------------------------------------------------------------
# Jekyll build output and caches
# ------------------------------------------------------------------------------
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# ------------------------------------------------------------------------------
# Ruby / Bundler (only created if you preview the site locally)
# GitHub Pages uses its own pinned gems and ignores Gemfile.lock, so committing
# it is counterproductive: https://github.com/github/pages-gem/issues/768
# ------------------------------------------------------------------------------
/vendor/
.bundle/
Gemfile.lock

# ------------------------------------------------------------------------------
# Editors and IDEs
# ------------------------------------------------------------------------------
# VS Code: ignore personal settings but keep shared project settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, RStudio-style IDEs, IntelliJ, RubyMine, WebStorm)
.idea/
*.iml
*.ipr
*.iws
out/

# RStudio
.Rproj.user/
.Rhistory
.RData

# Vim / Emacs temp files
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Scripting leftovers (if helper scripts are ever added)
# ------------------------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# ------------------------------------------------------------------------------
# Secrets and local data (never publish these)
# ------------------------------------------------------------------------------
.env
.env.*
*.sqlite3
*.log

# ------------------------------------------------------------------------------
# OS-generated files (macOS and Windows)
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini